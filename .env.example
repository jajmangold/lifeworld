# Copy to .env and fill in. .env is gitignored.

# Memory graph (Neo4j)
NEO4J_PASSWORD=change-me

# Neocortex (ADR-0003)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local services already on this host
QWEN_VLM_URL=http://127.0.0.1:8040     # visual cortex (vision; bring up on demand)
HIGGS_TTS_URL=http://127.0.0.1:8055    # speech out (OpenAI /v1/audio/speech)
GRANITE_STT_URL=                        # speech in (set when wired)

# Path overrides for render scripts (defaults shown)
# LIFEWORLD_SAMPLES_DIR=./samples
# LIFEWORLD_BOT_DIR=./bot
# A2F_DIR=./a2f
