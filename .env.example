# Copy to .env and fill in. .env is gitignored.

# Memory graph (Neo4j)
NEO4J_PASSWORD=change-me

# Neocortex (ADR-0003)
# DEEPSEEK_API_KEY already lives in the shared /srv/nvme-data/containers/.env and
# the login shell — do NOT duplicate it here. Compose pulls it via env_file or the
# host env; only override base/model below if needed.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Shared network services (Tailscale)
QWEN_URL=https://amd0.python-bull.ts.net/v1/chat/completions   # qwen9b — ALL vision-QA + chat (amd0)
QWEN_MODEL=Qwen3.5-9B-UD-Q4_K_XL.gguf
TTS_URL=http://amd1:8064               # qwen3-tts voxserver (amd1) — /mono, /dialogue, /v1/audio/speech
# Granite STT lives on amd0/amd1 — set when wired
GRANITE_STT_URL=
