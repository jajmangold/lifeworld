# Copy to .env and fill in. .env is gitignored.

# Memory graph (Neo4j)
NEO4J_PASSWORD=change-me

# Neocortex (ADR-0003)
# DEEPSEEK_API_KEY already lives in the shared /srv/nvme-data/containers/.env and
# the login shell — do NOT duplicate it here. Compose pulls it via env_file or the
# host env; only override base/model below if needed.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local services already on this host
QWEN_VLM_URL=http://127.0.0.1:8040     # visual cortex (vision; bring up on demand)
HIGGS_TTS_URL=http://127.0.0.1:8055    # speech out (OpenAI /v1/audio/speech)
# Granite STT lives on amd0/amd1 — set when wired
GRANITE_STT_URL=
