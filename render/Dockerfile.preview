# Fast lip-sync iteration: bake (smplx, CPU) + render (pyrender/EGL) in ONE container.
# Avoids the separate sampl:dev (bake) + lifeworld-pyrender (render) round-trips.
FROM lifeworld-pyrender
RUN pip3 install --no-cache-dir torch==2.4.1 --index-url https://download.pytorch.org/whl/cpu \
 && pip3 install --no-cache-dir smplx==0.1.28
WORKDIR /work
